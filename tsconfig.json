{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Le code partagé avec les Edge Functions (Deno) importe ses voisins avec
    // l'extension « .ts » : src/game et src/online.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Les Edge Functions tournent sous Deno et sont vérifiées par `deno check`.
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}
